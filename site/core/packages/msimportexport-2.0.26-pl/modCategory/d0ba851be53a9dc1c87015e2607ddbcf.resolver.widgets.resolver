<?php
/** @var xPDOTransport $transport */
/** @var array $options */
/** @var modX $modx */

if (!function_exists('makeWidget')) {
    function createWidget(array $data)
    {
        global $modx;
        $registry = $modx->registry;
        $modx->registry = null;
        /** @var modProcessorResponse $response */
        $response = $modx->runProcessor('system/dashboard/widget/create', $data);
        $modx->registry = $registry;
        if ($response->isError()) {
            $modx->log(modX::LOG_LEVEL_ERROR, $response->getMessage());
            return false;
        }
        return true;
    }
}

if ($transport->xpdo) {
    /** @var modX $modx */
    $modx = $transport->xpdo;
    $widgets = [[
        'name' => 'msimportexport_widget_tasks',
        'description' => 'msimportexport_widget_tasks_desc',
        'type' => 'file',
        'size' => 'full',
        'namespace' => 'msimportexport',
        'lexicon' => 'msimportexport:widget',
        'content' => '[[++core_path]]components/msimportexport/elements/widgets/tasks.widget.php',
    ],
    ];
    switch ($options[xPDOTransport::PACKAGE_ACTION]) {
        case xPDOTransport::ACTION_INSTALL:
        case xPDOTransport::ACTION_UPGRADE:
            foreach ($widgets as $widget) {
                $count = $modx->getCount('modDashboardWidget', ['namespace' => $widget['namespace'], 'name' => $widget['name']]);
                if ($count) {
                    continue;
                }
                createWidget($widget);
            }
            break;
        case xPDOTransport::ACTION_UNINSTALL:
            break;
    }
}
return true;