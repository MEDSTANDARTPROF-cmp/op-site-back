[[pdoCrumbs?
	&showAtHome=`0`
	&showHome=`1`
	&tplWrapper=`@INLINE <ol class="breadcrumb opacity-50">[[+output]]</ol>`
	&tpl=`@INLINE <li class="breadcrumb-item"><a class="link-dark" href="[[+link]]">[[+menutitle]]</a></li>`
	&tplCurrent=`@INLINE <li class="breadcrumb-item active" aria-current="page">[[+menutitle]]</li>`
]]