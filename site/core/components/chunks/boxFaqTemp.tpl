                            <div class="container">
                                <h4 class="fw-8 h2 py-5 text-light">Часто задаваемые вопросы</h4>
                                <div class="position-relative overflow-hidden">
                                    <div class="accordion" id="accordionExample">
                                        [[getImageList?
                                            &tvname=`boxFaqTv`
                                            &tpl=`boxFaqTpl`
                                            &docid=`[[*id]]`
                                            &limit=`9`
                                        ]]
                                    </div>
                                </div>
                            </div>
                        </div>
                        `]]