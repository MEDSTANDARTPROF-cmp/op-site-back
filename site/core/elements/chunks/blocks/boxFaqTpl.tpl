<div class="accordion-item">
    <div class="accordion-header  h2 ">
        <button class="accordion-button collapsed fw-7 fs-18" type="button" data-bs-toggle="collapse" data-bs-target="#collapse[[+idx]]" aria-expanded="false" aria-controls="collapse[[+idx]]">
            [[+tetle]]
        </button>
    </div>
    <div id="collapse[[+idx]]" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
        <div class="accordion-body">
            [[+content]]
        </div>
    </div>
</div>
